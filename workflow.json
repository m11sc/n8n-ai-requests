    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.text || '';\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\nlet data;\ntry {\n  data = JSON.parse(match ? match[0] : raw);\n} catch (e) {\n  data = { category: 'не распознано', urgency: 'обычная', summary: raw.slice(0, 200) };\n}\n\nconst form = $('On form submission').item.json;\n\nreturn {\n  json: {\n    date: form.submittedAt,\n    name: form['Имя'],\n    contact: form['Контакт'],\n    text: form['Текст заявки'],\n    category: data.category,\n    urgency: data.urgency,\n    summary: data.summary\n  }\n};"
      },
